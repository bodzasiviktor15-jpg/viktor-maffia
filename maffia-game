<!DOCTYPE html>
<html lang="hu">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Magyar Maffia Online</title>
    <style>
        :root {
            --bg-color: #0c0c0e;
            --card-bg: #16161a;
            --accent-gold: #d4af37;
            --accent-gold-hover: #f1c40f;
            --text-main: #e2e2e9;
            --text-muted: #9494a0;
            --danger: #e74c3c;
            --success: #2ecc71;
            --border: #2a2a35;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            -webkit-tap-highlight-color: transparent;
        }

        body {
            background-color: var(--bg-color);
            color: var(--text-main);
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 10px;
        }

        .game-container {
            width: 100%;
            max-width: 480px;
            background: var(--card-bg);
            border: 2px solid var(--accent-gold);
            border-radius: 12px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.8);
            overflow: hidden;
            display: flex;
            flex-direction: column;
        }

        header {
            background: linear-gradient(135deg, #1a1a24, #0c0c0e);
            padding: 15px;
            text-align: center;
            border-bottom: 2px solid var(--border);
        }

        header h1 {
            color: var(--accent-gold);
            font-size: 1.5rem;
            letter-spacing: 2px;
            text-transform: uppercase;
        }

        .stats-bar {
            display: flex;
            justify-content: space-around;
            background: #111116;
            padding: 10px;
            border-bottom: 1px solid var(--border);
            font-weight: bold;
            font-size: 0.9rem;
        }

        .stat-item {
            display: flex;
            align-items: center;
            gap: 5px;
        }

        .money { color: var(--success); }
        .energy { color: #f39c12; }

        .content {
            padding: 15px;
            overflow-y: auto;
            max-height: calc(100vh - 180px);
            flex-grow: 1;
        }

        .card {
            background: #1c1c24;
            border: 1px solid var(--border);
            border-radius: 8px;
            padding: 12px;
            margin-bottom: 15px;
        }

        .card h3 {
            color: var(--accent-gold);
            font-size: 1.1rem;
            margin-bottom: 8px;
            border-bottom: 1px solid var(--border);
            padding-bottom: 5px;
        }

        .btn {
            background: linear-gradient(to bottom, #d4af37, #aa8c2c);
            color: #000;
            border: none;
            padding: 12px;
            width: 100%;
            font-weight: bold;
            border-radius: 6px;
            cursor: pointer;
            font-size: 1rem;
            text-transform: uppercase;
            transition: 0.2s;
            margin-top: 8px;
            box-shadow: 0 4px 6px rgba(0,0,0,0.3);
        }

        .btn:active {
            transform: scale(0.98);
        }

        .btn:hover {
            background: linear-gradient(to bottom, #f1c40f, #d4af37);
        }

        .btn-secondary {
            background: #2a2a35;
            color: var(--text-main);
            border: 1px solid var(--accent-gold);
        }

        .btn-secondary:hover {
            background: #3a3a4a;
        }

        .nav-tabs {
            display: flex;
            background: #0c0c0e;
            border-top: 2px solid var(--border);
        }

        .tab-btn {
            flex: 1;
            background: none;
            border: none;
            color: var(--text-muted);
            padding: 12px;
            font-size: 0.9rem;
            font-weight: bold;
            cursor: pointer;
            transition: 0.3s;
            text-align: center;
        }

        .tab-btn.active {
            color: var(--accent-gold);
            background: #16161a;
            border-top: 2px solid var(--accent-gold);
        }

        .tab-content {
            display: none;
        }

        .tab-content.active {
            display: block;
        }

        .log-box {
            background: #09090b;
            border: 1px solid var(--border);
            border-radius: 6px;
            padding: 10px;
            height: 100px;
            overflow-y: auto;
            font-size: 0.8rem;
            color: var(--text-muted);
            margin-top: 10px;
        }

        .progress-bar {
            background: #2a2a35;
            border-radius: 4px;
            height: 8px;
            width: 100%;
            overflow: hidden;
            margin-top: 5px;
        }

        .progress-fill {
            background: var(--accent-gold);
            height: 100%;
            width: 0%;
            transition: width 0.3s;
        }
    </style>
</head>
<body>

<div class="game-container">
    <header>
        <h1>Magyar Maffia Online</h1>
    </header>

    <div class="stats-bar">
        <div class="stat-item money">💰 <span id="money">0</span> Ft</div>
        <div class="stat-item energy">⚡ <span id="energy">100</span>/100</div>
    </div>

    <div class="content">
        <!-- FŐOLDAL / KARAKTER -->
        <div id="tab-home" class="tab-content active">
            <div class="card" style="text-align: center;">
                <h3>Karakter Státusz</h3>
                <p>Rang: <strong id="rank" style="color: var(--accent-gold);">Kisfőnök</strong></p>
                <p style="margin-top: 5px;">Szint: <span id="level">1</span></p>
                <div class="progress-bar">
                    <div id="xp-fill" class="progress-fill"></div>
                </div>
                <p style="font-size: 0.75rem; color: var(--text-muted); margin-top: 3px;"><span id="xp">0</span> / <span id="xp-max">100</span> XP</p>
            </div>

            <div class="card">
                <h3>Tulajdonságok</h3>
                <p>💪 Erő: <span id="stat-strength">15</span></p>
                <p>🤝 Befolyás: <span id="stat-influence">10</span></p>
                <p>🛡️ Fegyverzet: <span id="stat-weapon">Ököl</span></p>
            </div>

            <button class="btn" onclick="collectProtectionMoney()">💵 Védelmi Pénz Beszedése</button>
        </div>

        <!-- BŰNTÉNYEK -->
        <div id="tab-crimes" class="tab-content">
            <div class="card">
                <h3>Utcai Akciók</h3>
                <p style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: 10px;">Hajts végre balhékat a vagyonért és az XP-ért!</p>
                
                <button class="btn btn-secondary" onclick="commitCrime('zsebmetszés', 10, 1500, 15)">Zsebmetszés (⚡10 | 1500 Ft)</button>
                <button class="btn btn-secondary" onclick="commitCrime('autólopás', 25, 6000, 40)" style="margin-top: 8px;">Autólopás (⚡25 | 6000 Ft)</button>
                <button class="btn btn-secondary" onclick="commitCrime('bankrablás', 50, 18000, 90)" style="margin-top: 8px;">Bankrablás (⚡50 | 18000 Ft)</button>
            </div>

            <div class="card">
                <h3>Esemény napló</h3>
                <div id="log-box" class="log-box">A játék elindult. Üdv a családban, főnök!</div>
            </div>
        </div>

        <!-- FEKETENAPIAC / BOLT -->
        <div id="tab-shop" class="tab-content">
            <div class="card">
                <h3>Feketepiaci Fegyverbolt</h3>
                <p style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: 10px;">Vásárolj felszerelést az Erőd növeléséhez.</p>
                
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px; background: #111; padding: 8px; border-radius: 4px;">
                    <div>
                        <strong>Kutyaól Késsel</strong><br><small style="color:var(--text-muted);">+10 Erő</small>
                    </div>
                    <button class="btn" style="width: auto; padding: 6px 12px; margin:0;" onclick="buyItem('Kés', 10, 5000)">5 000 Ft</button>
                </div>

                <div style="display: flex; justify-content: space-between; align-items: center; background: #111; padding: 8px; border-radius: 4px;">
                    <div>
                        <strong>Marosvásárhelyi Vascső</strong><br><small style="color:var(--text-muted);">+30 Erő</small>
                    </div>
                    <button class="btn" style="width: auto; padding: 6px 12px; margin:0;" onclick="buyItem('Vascső', 30, 20000)">20 000 Ft</button>
                </div>
            </div>
        </div>
    </div>

    <div class="nav-tabs">
        <button class="tab-btn active" onclick="switchTab('home', event)">Karakter</button>
        <button class="tab-btn" onclick="switchTab('crimes', event)">Bűntények</button>
        <button class="tab-btn" onclick="switchTab('shop', event)">Bolt</button>
    </div>
</div>

<script>
    let player = {
        money: 2000,
        energy: 100,
        maxEnergy: 100,
        level: 1,
        xp: 0,
        maxXp: 100,
        strength: 15,
        influence: 10,
        weapon: "Ököl"
    };

    function updateUI() {
        document.getElementById('money').innerText = player.money.toLocaleString();
        document.getElementById('energy').innerText = player.energy;
        document.getElementById('level').innerText = player.level;
        document.getElementById('xp').innerText = player.xp;
        document.getElementById('xp-max').innerText = player.maxXp;
        document.getElementById('stat-strength').innerText = player.strength;
        document.getElementById('stat-influence').innerText = player.influence;
        document.getElementById('stat-weapon').innerText = player.weapon;
        
        let xpPercent = (player.xp / player.maxXp) * 100;
        document.getElementById('xp-fill').style.width = xpPercent + '%';
    }

    function logMessage(msg) {
        let box = document.getElementById('log-box');
        box.innerHTML += `<br>• ${msg}`;
        box.scrollTop = box.scrollHeight;
    }

    function switchTab(tabName, event) {
        document.querySelectorAll('.tab-content').forEach(el => el.classList.remove('active'));
        document.querySelectorAll('.tab-btn').forEach(el => el.classList.remove('active'));
        
        document.getElementById('tab-' + tabName).classList.add('active');
        event.currentTarget.classList.add('active');
    }

    function collectProtectionMoney() {
        player.money += 500;
        logMessage("Sikeresen beszedted a védelmi pénzt (+500 Ft).");
        updateUI();
    }

    function commitCrime(name, energyCost, rewardMoney, rewardXp) {
        if (player.energy < energyCost) {
            logMessage("Nincs elég energiád ehhez az akcióhoz! Pihenj egy kicsit.");
            return;
        }

        player.energy -= energyCost;
        player.money += rewardMoney;
        player.xp += rewardXp;

        logMessage(`Sikeres akció: ${name}! Kaptál ${rewardMoney} Ft-ot és ${rewardXp} XP-t.`);

        if (player.xp >= player.maxXp) {
            player.level++;
            player.xp -= player.maxXp;
            player.maxXp = Math.floor(player.maxXp * 1.5);
            player.strength += 10;
            logMessage(`🎉 Szintet léptél! Új szint: ${player.level}`);
        }

        updateUI();
    }

    function buyItem(weaponName, strengthBonus, cost) {
        if (player.money < cost) {
            logMessage("Nincs elég pénzed ehhez a felszereléshez!");
            return;
        }

        player.money -= cost;
        player.strength += strengthBonus;
        player.weapon = weaponName;
        logMessage(`Megvásároltad: ${weaponName}! Új erőd: ${player.strength}`);
        updateUI();
    }

    // Energia visszatöltés idővel
    setInterval(() => {
        if (player.energy < player.maxEnergy) {
            player.energy = Math.min(player.maxEnergy, player.energy + 5);
            updateUI();
        }
    }, 5000);

    updateUI();
</script>

</body>
</html>
